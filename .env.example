# Copy to .env for local development. Real environment variables win over .env.

# ----- Server -----
# development | test | production
APP_ENV=development
PORT=4000

# Comma-separated allowlist of frontend origins (user, merchant, admin apps).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Set true ONLY behind a reverse proxy that sets X-Forwarded-For / X-Real-IP;
# the rate limiter then keys on the real client IP. Otherwise clients can spoof it.
TRUST_PROXY=false

# ----- Database (PostgreSQL 13+) -----
# Pool size is tunable in the URL, e.g. &pool_max_conns=20
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shopwave_go?sslmode=disable

# ----- Auth -----
# Long random string; at least 32 chars in production: `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
# Session length as a Go duration (168h = 7 days). Also the auth cookie's max age.
JWT_TTL=168h
# httpOnly cookie holding the JWT
COOKIE_NAME=token
# httpOnly cookie holding the anonymous guest-cart session id
CART_COOKIE_NAME=cart_sid
# Production only: parent domain so cookies are shared across subdomains, e.g. .app.com
# COOKIE_DOMAIN=.app.com
